# ── MongoDB (use MongoDB Atlas free M0 cluster for production) ──
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/biotwin?retryWrites=true&w=majority

# ── Redis (optional — app works without it) ──
# REDIS_URL=redis://localhost:6379

# ── JWT ──
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d

# ── Server ──
PORT=5001
NODE_ENV=production

# ── ML Server URL (set to your deployed ML server) ──
ML_SERVER_URL=https://biotwin-ml.onrender.com
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=biotwin-uploads
AWS_REGION=us-east-1

# ── ML Server ──
ML_SERVER_URL=http://localhost:8000

# ── CORS ──
FRONTEND_URL=http://localhost:3000
